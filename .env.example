# NEVER commit a real .env file with your GitHub token to this repo.
# NEVER commit a real .env file with your Discord token to this repo.
# NEVER commit a real .env file. Please.
# Be sure to add your .env file to .gitignore!
# You may want to use SSH instead of HTTPS for secure automation.

# For Docker deployment, copy this template to /etc/paulbot/paulbot.env.
# Do not overwrite an existing credential file. Never commit paulbot.env.

# Discord bot token (get this from the Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
# The ID of the Discord server (guild) where the bot should operate
DISCORD_GUILD_ID=your_guild_id_here

# The ID of the voice channel the bot should auto-join
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Log path inside the container; /app/logs is mounted from /var/log/paulbot.
# If opening this path fails, fall back to paulbot.log, then console only.
LOG_FILE_PATH=/app/logs/paulbot.log

# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default is WARNING if unset or invalid. Use INFO or DEBUG temporarily.
# Changes require restarting or recreating the container, not rebuilding it.
LOG_LEVEL=WARNING

# --- GitHub sync credentials for paulbot_sync.sh ---
# Your GitHub username (used for authenticated git commands)
GITHUB_USERNAME=your_username_here

# Your GitHub personal access token (NEVER commit the real one)
GITHUB_TOKEN=your_personal_access_token_here
